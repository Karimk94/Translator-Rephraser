<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
  web.config — IIS Configuration for Translator Rephraser API
  ============================================================================
  Deployment path : C:\edms\Translator Rephraser py (or similar)
  IIS Site binding: http://*:5005

  This uses the HttpPlatformHandler to launch Uvicorn
  and proxy traffic to it, avoiding FastCGI entirely.
  ============================================================================
-->
<configuration>
    <system.webServer>
        <handlers>
            <remove name="WebDAV" />
            <remove name="OPTIONSVerbHandler" />
            <remove name="TRACEVerbHandler" />
            
            <add name="httpPlatformHandler" path="*" verb="*" 
                 modules="httpPlatformHandler" 
                 resourceType="Unspecified" 
                 requireAccess="Script" 
                 responseBufferLimit="0" />
        </handlers>

        <!-- 
          HttpPlatformHandler launches python running Uvicorn.
          Uvicorn serves the FastAPI app (app:app) on the dynamic port assigned by IIS.
        -->
        <httpPlatform processPath=".\venv\Scripts\python.exe" 
                      arguments="-m uvicorn app:app --host 0.0.0.0 --port %HTTP_PLATFORM_PORT% --timeout-keep-alive 120" 
                      stdoutLogEnabled="true" 
                      stdoutLogFile=".\logs\python-stdout.log" 
                      startupTimeLimit="120" 
                      startupRetryCount="3"
                      requestTimeout="00:20:00" 
                      processesPerApplication="1">
            <environmentVariables>
                <environmentVariable name="PYTHONPATH" value="." />
            </environmentVariables>
        </httpPlatform>

        <!-- Request filtering limits (32 MB) -->
        <security>
            <requestFiltering>
                <requestLimits maxAllowedContentLength="33554432" />
            </requestFiltering>
        </security>
    </system.webServer>
</configuration>
